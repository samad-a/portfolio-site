# Copy to .env.local for local development. On Vercel, set these under
# Settings > Environment Variables. Never commit real values.

# API key from https://resend.com/api-keys, used to send contact form messages.
RESEND_API_KEY=

# Optional. The sender for contact form emails, on a domain verified in Resend,
# such as "Portfolio <contact@samadali.dev>". Without it, Resend's test sender
# is used, which only delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=
